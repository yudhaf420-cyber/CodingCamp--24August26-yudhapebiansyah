{
	"name": "html-live-preview-pro",
	"displayName": "HTML Live Preview Pro",
	"description": "Instant, secure HTML preview inside VS Code with auto-reload, browser hand-off, and zero configuration.",
	"version": "1.0.1",
	"publisher": "PutraAdiJaya",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/PutraAdiJaya/html-live-preview-pro"
	},
	"bugs": {
		"url": "https://github.com/PutraAdiJaya/html-live-preview-pro/issues"
	},
	"homepage": "https://github.com/PutraAdiJaya/html-live-preview-pro#readme",
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"html",
		"preview",
		"webview",
		"live",
		"real-time",
		"browser",
		"email",
		"prototype"
	],
	"activationEvents": [
		"onLanguage:html",
		"onCommand:extension.previewHtml",
		"onCommand:extension.previewHtmlDesktop",
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"icon": "images/icon.png",
	"contributes": {
		"commands": [
			{
				"command": "extension.previewHtml",
				"title": "🔍 Open Preview HTML",
				"icon": "$(open-preview)"
			},
			{
				"command": "extension.previewHtmlDesktop",
				"title": "🌐 Open Preview in Browser",
				"icon": "$(device-desktop)"
			}
		],
		"keybindings": [
			{
				"command": "extension.previewHtml",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p",
				"when": "editorTextFocus && resourceLangId == html"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "extension.previewHtml",
					"when": "htmlPreview.canShowButton",
					"group": "navigation"
				},
				{
					"command": "extension.previewHtmlDesktop",
					"when": "htmlPreview.canShowButton",
					"group": "navigation@2"
				}
			],
			"editor/title/secondary": [
				{
					"command": "extension.previewHtml",
					"when": "htmlPreview.canShowButton",
					"group": "navigation"
				},
				{
					"command": "extension.previewHtmlDesktop",
					"when": "htmlPreview.canShowButton",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "extension.previewHtml",
					"when": "htmlPreview.canShowButton",
					"group": "navigation"
				},
				{
					"command": "extension.previewHtmlDesktop",
					"when": "htmlPreview.canShowButton",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "extension.previewHtml",
					"when": "resourceLangId == html",
					"group": "navigation"
				},
				{
					"command": "extension.previewHtmlDesktop",
					"when": "resourceLangId == html",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run lint",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@types/glob": "^8.0.0",
		"@types/mocha": "^10.0.1",
		"@types/node": "16.x",
		"@types/vscode": "^1.70.0",
		"@typescript-eslint/eslint-plugin": "^5.53.0",
		"@typescript-eslint/parser": "^5.53.0",
		"@vscode/test-electron": "^2.2.3",
		"@vscode/vsce": "^3.7.1",
		"eslint": "^8.34.0",
		"glob": "^8.1.0",
		"mocha": "^10.2.0",
		"typescript": "^4.9.5"
	},
	"__metadata": {
		"installedTimestamp": 1788874596900,
		"targetPlatform": "universal",
		"size": 45246
	}
}